{
  "name": "qwen-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/sse.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Variant all",
    "pack:no-model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Variant no-model",
    "pack:with-model": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Variant with-model",
    "tauri": "tauri"
  },
  "dependencies": { "@tauri-apps/api": "^2.5.0" },
  "devDependencies": { "@tauri-apps/cli": "^2.5.0", "@types/node": "^22.15.0", "typescript": "~5.8.3", "vite": "^6.3.5" }
}
